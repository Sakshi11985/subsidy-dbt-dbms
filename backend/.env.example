PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subsidy_dbt
MONGO_URL=mongodb://localhost:27017
MONGO_DB=subsidy_dbt
# Secret for the keyed Aadhaar hash. Change it; never commit the real one.
AADHAAR_HMAC_KEY=change-this-to-a-long-random-string
BANK_LATENCY_MS=40
# Secret that signs login tokens. If unset, a random one is made at each start.
SESSION_SECRET=change-this-to-another-long-random-string
